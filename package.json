  "engines": {
    "node": ">=22.23.4"
  },
  "packageManager": "pnpm@12.10.1",
  "dependencies": {
    "@fontsource-variable/archivo": "5.3.0",
    "@fontsource-variable/red-hat-mono": "5.3.0",
    "lucide-react": "1.70.0",
    "react": "19.3.1",
    "react-dom": "19.3.1",
    "react-router": "8.5.1"
  },
  "devDependencies": {
    "@types/node": "26.6.6",
    "@types/react": "19.3.0",
    "@types/react-dom": "19.3.0",
    "@vitejs/plugin-react": "6.3.0",
    "typescript": "5.9.3",
    "vite": "8.3.7"
  }
}
